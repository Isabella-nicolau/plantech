<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { pageTitle: 'Saidas' }) %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">
      <%- include('partials/topbar', { topTitle: 'Relatorios', topSubtitle: 'Analise de fluxo e consumo' }) %>

      <div class="page-content">
        <div class="page-header">
          <div class="page-header-left">
            <h2>Saidas de Estoque</h2>
          </div>
          <div class="quick-nav">
            <a href="/relatorios">Vendas</a>
            <a href="/relatorios/saidas" class="active">Saidas</a>
            <a href="/relatorios/estoque">Estoque</a>
            <a href="/relatorios/financeiro">Financeiro</a>
          </div>
        </div>

        <div class="card" style="margin-bottom: 24px;">
          <div class="card-body">
            <form action="/relatorios/saidas" method="GET" class="d-flex gap-sm items-center" style="flex-wrap: wrap;">
              <div style="flex: 1; min-width: 160px;">
                <label class="form-label">Data inicio</label>
                <input type="date" name="dataInicio" class="form-control" value="<%= query.dataInicio %>">
              </div>
              <div style="flex: 1; min-width: 160px;">
                <label class="form-label">Data fim</label>
                <input type="date" name="dataFim" class="form-control" value="<%= query.dataFim %>">
              </div>
              <div style="padding-top: 22px;">
                <button class="btn btn-primary">Filtrar</button>
              </div>
            </form>
          </div>
        </div>

        <% if (ranking.length > 0) { %>
          <h6 style="margin-bottom: 12px;">Top 5 mais vendidos</h6>
          <div class="kpi-grid" style="grid-template-columns: repeat(5, 1fr); margin-bottom: 24px;">
            <% ranking.forEach(function(item, index) { %>
              <div class="kpi-card" style="text-align: center;">
                <span class="badge badge-warning" style="margin-bottom: 8px;"><%= index + 1 %>o</span>
                <div class="kpi-card-value"><%= item.totalQtd %></div>
                <div class="kpi-card-label" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= item.nomeProduto %></div>
              </div>
            <% }) %>
          </div>
        <% } %>

        <div class="table-wrapper">
          <div class="card-header">
            <h3><i class="bi bi-list-ul" style="color: var(--primary);"></i> Registro de saidas</h3>
            <button onclick="baixarPDFSaidas()" class="btn btn-secondary btn-sm no-print">
              <i class="bi bi-download"></i> Baixar PDF
            </button>
          </div>
          <table class="data-table">
            <thead>
              <tr>
                <th>Data</th>
                <th>Produto</th>
                <th>Categoria</th>
                <th>Cliente</th>
                <th style="text-align: center;">Baixa</th>
              </tr>
            </thead>
            <tbody>
              <% lista.forEach(item => { %>
                <tr>
                  <td style="color: var(--text-muted);"><%= new Date(item.dataVenda).toLocaleDateString() %></td>
                  <td class="col-primary"><%= item.nomeProduto %></td>
                  <td><span class="badge badge-default"><%= item.categoria %></span></td>
                  <td><%= item.nomeCliente %></td>
                  <td style="text-align: center;"><span class="badge badge-error">- <%= item.quantidade %></span></td>
                </tr>
              <% }) %>
              <% if (lista.length === 0) { %>
                <tr><td colspan="5" class="empty-state"><p>Nenhuma saida registrada.</p></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="text-center mt-24" style="font-size: 0.75rem; color: var(--text-muted);">
          Relatorio gerado em <%= new Date().toLocaleDateString() %> as <%= new Date().toLocaleTimeString() %>
        </div>
      </div>
    </main>
  </div>

  <div id="relatorio-pdf" class="report-pdf">
    <div class="report-header">
      <div>
        <h1>Plantech ERP</h1>
        <h2>Relatorio de Baixa de Produtos (Saidas)</h2>
      </div>
      <div class="report-info">
        <p><strong>Carrapicho Jardinagem</strong></p>
        <p>CNPJ: 32.665.550/0001-00</p>
        <p>Periodo: <%= query.dataInicio || 'Inicio' %> a <%= query.dataFim || 'Hoje' %></p>
        <p>Emissao: <%= new Date().toLocaleString() %></p>
      </div>
    </div>
    <% if (ranking.length > 0) { %>
      <div style="background: #eee; padding: 8px; font-weight: bold; border-left: 5px solid #f97316; margin: 20px 0 10px 0; font-size: 13px;">Destaques de Consumo</div>
      <div style="display: flex; gap: 10px; margin-bottom: 20px;">
        <% ranking.slice(0, 5).forEach(function(item, index) { %>
          <div style="border: 1px solid #ddd; background: #fdfdfd; padding: 10px; flex: 1; text-align: center; border-radius: 5px;">
            <div style="font-size: 10px; margin-bottom: 5px;"><%= index + 1 %>o Lugar</div>
            <div style="font-size: 18px; font-weight: bold; color: #f97316;"><%= item.totalQtd %> un.</div>
            <span style="font-size: 11px; margin-top: 5px; display: block;"><%= item.nomeProduto %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
    <div style="background: #eee; padding: 8px; font-weight: bold; border-left: 5px solid #f97316; margin: 20px 0 10px 0; font-size: 13px;">Detalhamento das Baixas</div>
    <table class="report-table">
      <thead>
        <tr>
          <th style="width: 15%;">Data</th>
          <th style="width: 35%;">Produto</th>
          <th style="width: 15%;">Categoria</th>
          <th style="width: 25%;">Cliente</th>
          <th style="width: 10%; text-align: center;">Baixa</th>
        </tr>
      </thead>
      <tbody>
        <% if (lista && lista.length > 0) { %>
          <% lista.forEach(item => { %>
            <tr>
              <td><%= new Date(item.dataVenda).toLocaleDateString() %></td>
              <td><strong><%= item.nomeProduto %></strong></td>
              <td><%= item.categoria %></td>
              <td><%= item.nomeCliente %></td>
              <td style="text-align: center; font-weight: bold; color: #d32f2f;">- <%= item.quantidade %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="5" style="text-align: center; padding: 20px;">Nenhum dado para exibir neste periodo.</td></tr>
        <% } %>
      </tbody>
    </table>
    <div class="report-footer">
      <span>Sistema Plantech v2.5</span>
      <span>Relatorio de controle interno de fluxo.</span>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/app.js"></script>

  <script>
    function baixarPDFSaidas() {
      var elemento = document.getElementById('relatorio-pdf');
      elemento.style.display = 'block';
      var opt = {
        margin: [10, 10, 15, 10],
        filename: 'Relatorio_Saidas_Plantech.pdf',
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, scrollY: 0 },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
      };
      html2pdf().set(opt).from(elemento).save().then(function() { elemento.style.display = 'none'; });
    }
  </script>
</body>
</html>
