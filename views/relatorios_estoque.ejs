<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { pageTitle: 'Estoque' }) %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">
      <%- include('partials/topbar', { topTitle: 'Relatorios', topSubtitle: 'Analise de dados e inventario' }) %>

      <div class="page-content">
        <div class="page-header">
          <div class="page-header-left">
            <h2>Posicao de Estoque</h2>
          </div>
          <div class="quick-nav">
            <a href="/relatorios">Vendas</a>
            <a href="/relatorios/saidas">Saidas</a>
            <a href="/relatorios/estoque" class="active">Estoque</a>
            <a href="/relatorios/financeiro">Financeiro</a>
          </div>
        </div>

        <div class="kpi-grid" style="grid-template-columns: repeat(3, 1fr);">
          <div class="kpi-card">
            <div class="kpi-card-icon blue"><i class="bi bi-box-seam"></i></div>
            <div class="kpi-card-value"><%= stats.totalItens %></div>
            <div class="kpi-card-label">Produtos cadastrados</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-card-icon red"><i class="bi bi-exclamation-triangle"></i></div>
            <div class="kpi-card-value"><%= stats.itensZerados %></div>
            <div class="kpi-card-label">Itens esgotados</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-card-icon green"><i class="bi bi-currency-dollar"></i></div>
            <div class="kpi-card-value">R$ <%= stats.valorPatrimonial.toFixed(2) %></div>
            <div class="kpi-card-label">Valor patrimonial estimado</div>
          </div>
        </div>

        <div class="table-wrapper">
          <div class="card-header">
            <h3><i class="bi bi-list-ul" style="color: var(--primary);"></i> Estoque fisico</h3>
            <button onclick="baixarPDFEstoque()" class="btn btn-secondary btn-sm no-print">
              <i class="bi bi-download"></i> Baixar PDF
            </button>
          </div>
          <table class="data-table">
            <thead>
              <tr>
                <th>Produto</th>
                <th>Categoria</th>
                <th style="text-align: center;">Qtd. atual</th>
                <th>Preco venda</th>
                <th style="text-align: right;">Total</th>
                <th style="text-align: center;">Status</th>
              </tr>
            </thead>
            <tbody>
              <% lista.forEach(p => { %>
                <tr>
                  <td class="col-primary"><%= p.nomeProduto %></td>
                  <td><span class="badge badge-default"><%= p.categoria %></span></td>
                  <td style="text-align: center;">
                    <span class="fw-600"><%= p.estoqueAtual %></span>
                    <span class="text-muted" style="font-size: 0.75rem;"><%= p.unidadeMedida %></span>
                  </td>
                  <td>R$ <%= p.precoVenda.toFixed(2) %></td>
                  <td style="text-align: right;"><span class="text-primary fw-600">R$ <%= (p.estoqueAtual * p.precoVenda).toFixed(2) %></span></td>
                  <td style="text-align: center;">
                    <% if(p.estoqueAtual === 0) { %>
                      <span class="badge badge-error">Esgotado</span>
                    <% } else if(p.estoqueAtual < 10) { %>
                      <span class="badge badge-warning">Baixo</span>
                    <% } else { %>
                      <span class="badge badge-success">Normal</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
              <% if(lista.length === 0) { %>
                <tr><td colspan="6" class="empty-state"><p>Nenhum produto no inventario.</p></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="text-center mt-24" style="font-size: 0.75rem; color: var(--text-muted);">
          Relatorio gerado em <%= new Date().toLocaleDateString() %> as <%= new Date().toLocaleTimeString() %>
        </div>
      </div>
    </main>
  </div>

  <div id="relatorio-pdf" class="report-pdf">
    <div class="report-header">
      <div>
        <h1>Plantech ERP</h1>
        <h2>Relatorio de Posicao de Estoque</h2>
      </div>
      <div class="report-info">
        <p><strong>Carrapicho Jardinagem</strong></p>
        <p>CNPJ: 32.665.550/0001-00</p>
        <p>Emissao: <%= new Date().toLocaleString() %></p>
      </div>
    </div>
    <div class="report-summary">
      <div style="display: flex; justify-content: space-between; margin-bottom: 5px;"><span>Total de Itens:</span><strong><%= stats.totalItens %></strong></div>
      <div style="display: flex; justify-content: space-between; margin-bottom: 5px;"><span>Itens Zerados:</span><strong style="color: #d32f2f;"><%= stats.itensZerados %></strong></div>
      <div style="display: flex; justify-content: space-between; border-top: 1px solid #ddd; padding-top: 5px; margin-top: 5px; font-weight: bold; color: #1A7A3A;"><span>Patrimonio Total:</span><span>R$ <%= stats.valorPatrimonial.toFixed(2) %></span></div>
    </div>
    <br>
    <table class="report-table">
      <thead>
        <tr>
          <th style="width: 30%;">Produto</th>
          <th style="width: 15%;">Categoria</th>
          <th style="width: 10%; text-align: center;">Qtd.</th>
          <th style="width: 10%;">Preco</th>
          <th style="width: 15%; text-align: right;">Total</th>
          <th style="width: 10%; text-align: center;">Status</th>
        </tr>
      </thead>
      <tbody>
        <% lista.forEach(p => { %>
          <tr>
            <td><strong><%= p.nomeProduto %></strong></td>
            <td><%= p.categoria %></td>
            <td style="text-align: center; font-weight: bold;"><%= p.estoqueAtual %> <%= p.unidadeMedida %></td>
            <td>R$ <%= p.precoVenda.toFixed(2) %></td>
            <td style="text-align: right;">R$ <%= (p.estoqueAtual * p.precoVenda).toFixed(2) %></td>
            <td style="text-align: center; font-weight: bold;">
              <%= p.estoqueAtual === 0 ? 'ESGOTADO' : (p.estoqueAtual < 10 ? 'BAIXO' : 'NORMAL') %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="report-footer">
      <span>Sistema Plantech v2.5</span>
      <span>Inventario fisico para conferencia.</span>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/app.js"></script>

  <script>
    function baixarPDFEstoque() {
      var elemento = document.getElementById('relatorio-pdf');
      elemento.style.display = 'block';
      var opt = {
        margin: [10, 10, 15, 10],
        filename: 'Inventario_Estoque_Plantech.pdf',
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2 },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
      };
      html2pdf().set(opt).from(elemento).save().then(function() { elemento.style.display = 'none'; });
    }
  </script>
</body>
</html>
