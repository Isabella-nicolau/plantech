<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { pageTitle: 'Funcionarios' }) %>
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">
      <%- include('partials/topbar', { topTitle: 'Funcionarios', topSubtitle: 'Equipe responsavel pelas ordens de servico' }) %>

      <div class="page-content">
        <div class="page-header">
          <div class="page-header-left">
            <h2>Quadro de Funcionarios</h2>
          </div>
          <div class="page-header-actions">
            <button onclick="limparForm()" class="btn btn-primary btn-sm"><i class="bi bi-plus"></i> Novo funcionario</button>
            <span class="badge-count"><%= lista.length %> registros</span>
          </div>
        </div>

        <% if (erro) { %>
          <div class="alert alert-error"><i class="bi bi-exclamation-circle"></i> <%= erro %></div>
        <% } %>

        <div class="split-layout">
          <div class="form-panel">
            <div class="form-panel-header">
              <i class="bi bi-person-badge"></i>
              <h3 id="formTitle">Novo funcionario</h3>
            </div>
            <div class="form-panel-body">
              <form action="/funcionarios/add" method="POST" class="needs-validation" id="formFuncionario" novalidate>
                <div class="form-group">
                  <label class="form-label">Nome completo <span class="required">*</span></label>
                  <input type="text" name="nome" id="inputNome" class="form-control" required placeholder="Ex: Joao da Silva">
                  <div class="form-error">Nome e obrigatorio.</div>
                </div>

                <div class="row-2col">
                  <div class="form-group">
                    <label class="form-label">Cargo</label>
                    <input type="text" name="cargo" id="inputCargo" class="form-control" placeholder="Ex: Jardineiro">
                  </div>
                  <div class="form-group">
                    <label class="form-label">Admissao</label>
                    <input type="date" name="dataAdmissao" id="inputAdmissao" class="form-control">
                  </div>
                </div>

                <div class="row-2col">
                  <div class="form-group">
                    <label class="form-label">Telefone</label>
                    <input type="text" name="telefone" id="inputTel" class="form-control" placeholder="(00) 00000-0000" oninput="mascaraTelefone(this)" maxlength="15">
                  </div>
                  <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" id="inputEmail" class="form-control" placeholder="funcionario@email.com">
                  </div>
                </div>

                <div class="form-group">
                  <label class="d-flex items-center gap-sm" style="cursor: pointer;">
                    <input type="checkbox" name="ativo" id="inputAtivo" value="1" checked>
                    Funcionario ativo
                  </label>
                </div>

                <div class="d-flex gap-sm" style="margin-top: 20px;">
                  <button type="submit" class="btn btn-primary btn-block" id="btnSalvar">
                    <i class="bi bi-check-lg"></i> Salvar
                  </button>
                  <button type="button" class="btn btn-secondary btn-block" id="btnCancelar" onclick="limparForm()" style="display:none;">
                    Cancelar
                  </button>
                </div>
              </form>
            </div>
          </div>

          <div class="table-wrapper">
            <div class="card-header">
              <h3><i class="bi bi-list-ul" style="color: var(--primary);"></i> Equipe cadastrada</h3>
            </div>
            <div class="table-scroll">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Nome</th>
                    <th>Cargo</th>
                    <th>Contato</th>
                    <th style="text-align: center;">Status</th>
                    <th style="text-align: right;">Acao</th>
                  </tr>
                </thead>
                <tbody>
                  <% lista.forEach(f => { %>
                    <tr>
                      <td class="col-primary"><%= f.nome %></td>
                      <td><span class="badge badge-default"><%= f.cargo || "-" %></span></td>
                      <td style="font-size: 0.8125rem; color: var(--text-secondary);">
                        <% if(f.telefone) { %><div><%= f.telefone %></div><% } %>
                        <% if(f.email) { %><div style="color: var(--text-muted);"><%= f.email %></div><% } %>
                      </td>
                      <td style="text-align: center;">
                        <% if (f.ativo) { %>
                          <span class="badge badge-success">Ativo</span>
                        <% } else { %>
                          <span class="badge badge-default">Inativo</span>
                        <% } %>
                      </td>
                      <td class="col-actions">
                        <button class="btn btn-ghost btn-icon sm" title="Editar"
                          onclick="editar(this)"
                          data-id="<%= f.idFuncionario %>"
                          data-nome="<%= f.nome %>"
                          data-cargo="<%= f.cargo %>"
                          data-tel="<%= f.telefone %>"
                          data-email="<%= f.email %>"
                          data-admissao="<%= f.dataAdmissao %>"
                          data-ativo="<%= f.ativo %>">
                          <i class="bi bi-pencil"></i>
                        </button>
                        <a href="/funcionarios/delete/<%= f.idFuncionario %>"
                           class="btn btn-danger btn-icon sm" title="Excluir"
                           onclick="return confirm('Tem certeza?');">
                          <i class="bi bi-trash3"></i>
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                  <% if (lista.length === 0) { %>
                    <tr>
                      <td colspan="5" class="empty-state">
                        <div class="empty-state-icon"><i class="bi bi-person-badge"></i></div>
                        <p>Nenhum funcionario cadastrado.</p>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/app.js"></script>

  <script>
    function mascaraTelefone(input) {
      var v = input.value.replace(/\D/g, "");
      if (v.length > 11) v = v.slice(0, 11);
      v = v.replace(/^(\d{2})(\d)/g, "($1) $2");
      v = v.replace(/(\d)(\d{4})$/, "$1-$2");
      input.value = v;
    }

    function editar(btn) {
      var d = btn.dataset;
      document.getElementById('inputNome').value = d.nome;
      document.getElementById('inputCargo').value = d.cargo === 'null' ? '' : d.cargo;
      document.getElementById('inputTel').value = d.tel === 'null' ? '' : d.tel;
      document.getElementById('inputEmail').value = d.email === 'null' ? '' : d.email;
      document.getElementById('inputAdmissao').value = d.admissao === 'null' ? '' : d.admissao;
      document.getElementById('inputAtivo').checked = d.ativo === '1';

      document.getElementById('formFuncionario').action = "/funcionarios/update/" + d.id;
      document.getElementById('formTitle').innerText = "Editar funcionario";
      document.getElementById('btnSalvar').innerHTML = '<i class="bi bi-check-lg"></i> Atualizar';
      document.getElementById('btnCancelar').style.display = "block";
      document.querySelector('.form-panel').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function limparForm() {
      var form = document.getElementById('formFuncionario');
      form.reset();
      form.classList.remove('was-validated');
      form.action = "/funcionarios/add";
      document.getElementById('formTitle').innerText = "Novo funcionario";
      document.getElementById('btnSalvar').innerHTML = '<i class="bi bi-check-lg"></i> Salvar';
      document.getElementById('btnCancelar').style.display = "none";
    }
  </script>
</body>
</html>
