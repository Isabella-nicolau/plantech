<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { pageTitle: 'Financeiro' }) %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">
      <%- include('partials/topbar', { topTitle: 'Relatorios', topSubtitle: 'DRE simplificado e fluxo de caixa' }) %>

      <div class="page-content">
        <div class="page-header">
          <div class="page-header-left">
            <h2>Financeiro</h2>
          </div>
          <% var podeAdmin = (typeof sessionUser !== 'undefined' && sessionUser && sessionUser.perfil === 'ADMIN'); %>
          <div class="quick-nav">
            <% if (podeAdmin) { %>
              <a href="/relatorios">Vendas</a>
              <a href="/relatorios/saidas">Saidas</a>
              <a href="/relatorios/estoque">Estoque</a>
              <a href="/relatorios/financeiro" class="active">Financeiro</a>
            <% } %>
            <a href="/relatorios/compras">Compras</a>
            <a href="/relatorios/servicos">Servicos</a>
            <a href="/relatorios/clientes">Clientes</a>
          </div>
        </div>

        <div class="card" style="margin-bottom: 24px;">
          <div class="card-body">
            <form action="/relatorios/financeiro" method="GET" class="d-flex gap-sm items-center" style="flex-wrap: wrap;">
              <div style="flex: 1; min-width: 160px;">
                <label class="form-label">Data inicio</label>
                <input type="date" name="dataInicio" class="form-control" value="<%= query.dataInicio %>">
              </div>
              <div style="flex: 1; min-width: 160px;">
                <label class="form-label">Data fim</label>
                <input type="date" name="dataFim" class="form-control" value="<%= query.dataFim %>">
              </div>
              <div style="padding-top: 22px;">
                <button class="btn btn-primary">Atualizar</button>
              </div>
            </form>
          </div>
        </div>

        <div class="kpi-grid" style="grid-template-columns: repeat(3, 1fr);">
          <div class="kpi-card">
            <div class="kpi-card-icon green"><i class="bi bi-arrow-up-right"></i></div>
            <div class="kpi-card-value">R$ <%= stats.receitas.toFixed(2) %></div>
            <div class="kpi-card-label">Total de receitas (vendas)</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-card-icon red"><i class="bi bi-arrow-down-right"></i></div>
            <div class="kpi-card-value">R$ <%= stats.despesas.toFixed(2) %></div>
            <div class="kpi-card-label">Total de despesas (compras)</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-card-icon <%= stats.lucro >= 0 ? 'green' : 'red' %>">
              <i class="bi bi-<%= stats.lucro >= 0 ? 'graph-up-arrow' : 'graph-down-arrow' %>"></i>
            </div>
            <div class="kpi-card-value" style="color: var(<%= stats.lucro >= 0 ? '--success' : '--error' %>);">R$ <%= stats.lucro.toFixed(2) %></div>
            <div class="kpi-card-label">Lucro liquido do periodo</div>
          </div>
        </div>

        <%
          var s = (typeof stats !== 'undefined' && stats) ? stats : { receitas: 0, despesas: 0 };
          var total = s.receitas + s.despesas;
          var pRec = total > 0 ? (s.receitas / total) * 100 : 0;
          var pDesp = total > 0 ? (s.despesas / total) * 100 : 0;
        %>

        <div class="card">
          <div class="card-header">
            <h3>Balanco financeiro</h3>
            <button onclick="baixarPDFFinanceiro()" class="btn btn-secondary btn-sm no-print">
              <i class="bi bi-download"></i> Baixar PDF
            </button>
          </div>
          <div class="card-body">
            <div class="progress-bar-container" style="height: 32px; display: flex; border-radius: var(--radius-sm); overflow: hidden;">
              <div style="width: <%= pRec %>%; background: var(--success); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 600; color: #fff; transition: width 0.6s ease;">
                <% if(pRec > 15) { %>Receita (<%= pRec.toFixed(0) %>%)<% } %>
              </div>
              <div style="width: <%= pDesp %>%; background: var(--error); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 600; color: #fff; transition: width 0.6s ease;">
                <% if(pDesp > 15) { %>Despesa (<%= pDesp.toFixed(0) %>%)<% } %>
              </div>
            </div>

            <div class="d-flex justify-between mt-16" style="font-size: 0.8125rem;">
              <div class="d-flex items-center gap-xs">
                <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--success);"></span>
                <span class="text-secondary">Receitas: vendas confirmadas no PDV</span>
              </div>
              <div class="d-flex items-center gap-xs">
                <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--error);"></span>
                <span class="text-secondary">Despesas: compras de fornecedores</span>
              </div>
            </div>
          </div>
        </div>

        <div class="text-center mt-24" style="font-size: 0.75rem; color: var(--text-muted);">
          Relatorio gerado em <%= new Date().toLocaleDateString() %> as <%= new Date().toLocaleTimeString() %>
        </div>
      </div>
    </main>
  </div>

  <div id="relatorio-pdf" class="report-pdf">
    <div class="report-header">
      <div>
        <h1>Plantech ERP</h1>
        <h2>Relatorio Financeiro Consolidado (DRE)</h2>
      </div>
      <div class="report-info">
        <p><strong>Carrapicho Jardinagem</strong></p>
        <p>CNPJ: 32.665.550/0001-00</p>
        <p>Periodo: <%= query.dataInicio || 'Inicio' %> a <%= query.dataFim || 'Hoje' %></p>
        <p>Emissao: <%= new Date().toLocaleString() %></p>
      </div>
    </div>
    <div style="border: 1px solid #ddd; padding: 15px; margin-bottom: 20px; background-color: #f9f9f9;">
      <h3 style="border-bottom: 1px solid #ccc; padding-bottom: 5px; margin-bottom: 15px; font-size: 14px; color: #333;">Demonstrativo de Resultados</h3>
      <div style="display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 14px;">
        <span>(+) Receita Bruta de Vendas</span>
        <span style="color: #1A7A3A;">R$ <%= stats.receitas.toFixed(2) %></span>
      </div>
      <div style="display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 14px;">
        <span>(-) Custo de Mercadoria Vendida / Compras</span>
        <span style="color: #c62828;">(R$ <%= stats.despesas.toFixed(2) %>)</span>
      </div>
      <div style="display: flex; justify-content: space-between; border-top: 1px solid #ccc; padding-top: 10px; font-weight: bold; font-size: 16px; color: #1A7A3A;">
        <span>(=) Lucro Liquido / Prejuizo</span>
        <span>R$ <%= stats.lucro.toFixed(2) %></span>
      </div>
    </div>
    <div style="padding: 15px; background-color: #fff3e0; border: 1px solid #ffe0b2; border-radius: 5px;">
      <strong>Analise Rapida:</strong>
      <p style="margin: 5px 0 0 0; font-size: 11px; color: #666;">
        O resultado operacional representa <%= total > 0 ? ((stats.lucro / stats.receitas) * 100).toFixed(1) : 0 %>% da receita bruta.
        <% if(stats.lucro >= 0) { %>
          A operacao esta superavitaria neste periodo.
        <% } else { %>
          Atencao: As despesas superaram as receitas neste periodo.
        <% } %>
      </p>
    </div>
    <div class="report-footer">
      <span>Sistema Plantech v2.5</span>
      <span>Documento para fins gerenciais.</span>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/app.js"></script>

  <script>
    function baixarPDFFinanceiro() {
      var elemento = document.getElementById('relatorio-pdf');
      elemento.style.display = 'block';
      var opt = {
        margin: [15, 15, 15, 15],
        filename: 'Relatorio_Financeiro_Plantech.pdf',
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2 },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
      };
      html2pdf().set(opt).from(elemento).save().then(function() { elemento.style.display = 'none'; });
    }
  </script>
</body>
</html>
