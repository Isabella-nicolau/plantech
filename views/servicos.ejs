<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { pageTitle: 'Servicos' }) %>
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">
      <%- include('partials/topbar', { topTitle: 'Servicos', topSubtitle: 'Catalogo de servicos prestados' }) %>

      <div class="page-content">
        <% var podeEditar = (typeof sessionUser !== 'undefined' && sessionUser && sessionUser.perfil === 'ADMIN'); %>
        <div class="page-header">
          <div class="page-header-left">
            <h2>Servicos Prestados</h2>
          </div>
          <div class="page-header-actions">
            <% if (podeEditar) { %>
              <button onclick="limparForm()" class="btn btn-primary btn-sm"><i class="bi bi-plus"></i> Novo servico</button>
            <% } %>
            <span class="badge-count"><%= lista.length %> registros</span>
          </div>
        </div>

        <% if (erro) { %>
          <div class="alert alert-error"><i class="bi bi-exclamation-circle"></i> <%= erro %></div>
        <% } %>

        <div class="split-layout">
          <% if (podeEditar) { %>
          <div class="form-panel">
            <div class="form-panel-header">
              <i class="bi bi-tools"></i>
              <h3 id="formTitle">Novo servico</h3>
            </div>
            <div class="form-panel-body">
              <form action="/servicos/add" method="POST" class="needs-validation" id="formServico" novalidate>
                <div class="form-group">
                  <label class="form-label">Nome <span class="required">*</span></label>
                  <input type="text" name="nome" id="inputNome" class="form-control" required placeholder="Ex: Poda de arvores">
                  <div class="form-error">Nome e obrigatorio.</div>
                </div>

                <div class="row-2col">
                  <div class="form-group">
                    <label class="form-label">Preco (R$) <span class="required">*</span></label>
                    <input type="number" step="0.01" name="preco" id="inputPreco" class="form-control" required placeholder="0.00">
                    <div class="form-error">Preco obrigatorio.</div>
                  </div>
                  <div class="form-group">
                    <label class="form-label">Duracao estimada (min)</label>
                    <input type="number" name="duracaoEstimada" id="inputDuracao" class="form-control" placeholder="60" min="0">
                  </div>
                </div>

                <div class="form-group">
                  <label class="form-label">Descricao</label>
                  <textarea name="descricao" id="inputDesc" class="form-control" rows="2" placeholder="Detalhes do servico..."></textarea>
                </div>

                <div class="form-group">
                  <label class="d-flex items-center gap-sm" style="cursor: pointer;">
                    <input type="checkbox" name="ativo" id="inputAtivo" value="1" checked>
                    Servico ativo
                  </label>
                </div>

                <div class="d-flex gap-sm" style="margin-top: 20px;">
                  <button type="submit" class="btn btn-primary btn-block" id="btnSalvar">
                    <i class="bi bi-check-lg"></i> Salvar
                  </button>
                  <button type="button" class="btn btn-secondary btn-block" id="btnCancelar" onclick="limparForm()" style="display:none;">
                    Cancelar
                  </button>
                </div>
              </form>
            </div>
          </div>
          <% } %>

          <div class="table-wrapper">
            <div class="card-header">
              <h3><i class="bi bi-list-ul" style="color: var(--primary);"></i> Catalogo de servicos</h3>
            </div>
            <div class="table-scroll">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Servico</th>
                    <th>Preco</th>
                    <th>Duracao</th>
                    <th style="text-align: center;">Status</th>
                    <% if (podeEditar) { %><th style="text-align: right;">Acao</th><% } %>
                  </tr>
                </thead>
                <tbody>
                  <% lista.forEach(s => { %>
                    <tr>
                      <td>
                        <div class="col-primary"><%= s.nome %></div>
                        <div style="font-size: 0.75rem; color: var(--text-muted); max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                          <%= s.descricao || "Sem descricao" %>
                        </div>
                      </td>
                      <td><span class="text-primary fw-600"><%= formatBRL(s.preco) %></span></td>
                      <td style="color: var(--text-muted);"><%= s.duracaoEstimada ? s.duracaoEstimada + " min" : "-" %></td>
                      <td style="text-align: center;">
                        <% if (s.ativo) { %>
                          <span class="badge badge-success">Ativo</span>
                        <% } else { %>
                          <span class="badge badge-default">Inativo</span>
                        <% } %>
                      </td>
                      <% if (podeEditar) { %>
                      <td class="col-actions">
                        <button class="btn btn-ghost btn-icon sm" title="Editar"
                          onclick="editar(this)"
                          data-id="<%= s.idServico %>"
                          data-nome="<%= s.nome %>"
                          data-preco="<%= s.preco %>"
                          data-duracao="<%= s.duracaoEstimada %>"
                          data-ativo="<%= s.ativo %>"
                          data-desc="<%= s.descricao %>">
                          <i class="bi bi-pencil"></i>
                        </button>
                        <a href="/servicos/delete/<%= s.idServico %>"
                           class="btn btn-danger btn-icon sm" title="Excluir"
                           onclick="return confirm('Tem certeza?');">
                          <i class="bi bi-trash3"></i>
                        </a>
                      </td>
                      <% } %>
                    </tr>
                  <% }) %>
                  <% if (lista.length === 0) { %>
                    <tr>
                      <td colspan="<%= podeEditar ? 5 : 4 %>" class="empty-state">
                        <div class="empty-state-icon"><i class="bi bi-tools"></i></div>
                        <p>Nenhum servico cadastrado.</p>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/app.js"></script>

  <script>
    function editar(btn) {
      var d = btn.dataset;
      document.getElementById('inputNome').value = d.nome;
      document.getElementById('inputPreco').value = d.preco;
      document.getElementById('inputDuracao').value = d.duracao === 'null' ? '' : d.duracao;
      document.getElementById('inputAtivo').checked = d.ativo === '1';
      document.getElementById('inputDesc').value = d.desc === 'null' ? '' : d.desc;

      document.getElementById('formServico').action = "/servicos/update/" + d.id;
      document.getElementById('formTitle').innerText = "Editar servico";
      document.getElementById('btnSalvar').innerHTML = '<i class="bi bi-check-lg"></i> Atualizar';
      document.getElementById('btnCancelar').style.display = "block";
      document.querySelector('.form-panel').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function limparForm() {
      var form = document.getElementById('formServico');
      form.reset();
      form.classList.remove('was-validated');
      form.action = "/servicos/add";
      document.getElementById('formTitle').innerText = "Novo servico";
      document.getElementById('btnSalvar').innerHTML = '<i class="bi bi-check-lg"></i> Salvar';
      document.getElementById('btnCancelar').style.display = "none";
    }
  </script>
</body>
</html>
