<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { pageTitle: 'Usuarios' }) %>
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">
      <%- include('partials/topbar', { topTitle: 'Usuarios', topSubtitle: 'Contas de acesso ao sistema' }) %>

      <div class="page-content">
        <div class="page-header">
          <div class="page-header-left">
            <h2>Usuarios do Sistema</h2>
          </div>
          <div class="page-header-actions">
            <button onclick="limparForm()" class="btn btn-primary btn-sm"><i class="bi bi-plus"></i> Novo usuario</button>
            <span class="badge-count"><%= lista.length %> registros</span>
          </div>
        </div>

        <% if (erro) { %>
          <div class="alert alert-error"><i class="bi bi-exclamation-circle"></i> <%= erro %></div>
        <% } %>

        <div class="split-layout">
          <div class="form-panel">
            <div class="form-panel-header">
              <i class="bi bi-person-gear"></i>
              <h3 id="formTitle">Novo usuario</h3>
            </div>
            <div class="form-panel-body">
              <form action="/usuarios/add" method="POST" class="needs-validation" id="formUsuario" novalidate>
                <div class="form-group">
                  <label class="form-label">Nome</label>
                  <input type="text" name="nome" id="inputNome" class="form-control" placeholder="Ex: Joana Souza">
                </div>

                <div class="form-group">
                  <label class="form-label">Usuario (login) <span class="required">*</span></label>
                  <input type="text" name="username" id="inputUsername" class="form-control" required placeholder="Ex: joana">
                  <div class="form-error">Usuario e obrigatorio.</div>
                </div>

                <div class="form-group" id="grupoSenha">
                  <label class="form-label">Senha <span class="required">*</span></label>
                  <input type="password" name="senha" id="inputSenha" class="form-control" required placeholder="Minimo 4 caracteres">
                  <div class="form-error">Senha e obrigatoria na criacao.</div>
                  <div class="form-hint" id="hintSenha" style="display:none;">Deixe em branco ao editar. Use "Redefinir senha" na lista para trocar a senha.</div>
                </div>

                <div class="form-group">
                  <label class="form-label">Perfil <span class="required">*</span></label>
                  <select name="perfil" id="selPerfil" class="form-select" required>
                    <option value="OPERADOR">OPERADOR</option>
                    <option value="ADMIN">ADMIN</option>
                  </select>
                </div>

                <div class="form-group">
                  <label class="d-flex items-center gap-sm" style="cursor: pointer;">
                    <input type="checkbox" name="ativo" id="inputAtivo" value="1" checked>
                    Usuario ativo
                  </label>
                </div>

                <div class="d-flex gap-sm" style="margin-top: 20px;">
                  <button type="submit" class="btn btn-primary btn-block" id="btnSalvar">
                    <i class="bi bi-check-lg"></i> Salvar
                  </button>
                  <button type="button" class="btn btn-secondary btn-block" id="btnCancelar" onclick="limparForm()" style="display:none;">
                    Cancelar
                  </button>
                </div>
              </form>
            </div>
          </div>

          <div class="table-wrapper">
            <div class="card-header">
              <h3><i class="bi bi-list-ul" style="color: var(--primary);"></i> Contas cadastradas</h3>
            </div>
            <div class="table-scroll">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Usuario</th>
                    <th>Perfil</th>
                    <th style="text-align: center;">Status</th>
                    <th style="text-align: right;">Acao</th>
                  </tr>
                </thead>
                <tbody>
                  <% lista.forEach(u => { %>
                    <tr>
                      <td>
                        <div class="col-primary"><%= u.username %></div>
                        <% if (u.nome) { %><div style="font-size: 0.75rem; color: var(--text-muted);"><%= u.nome %></div><% } %>
                      </td>
                      <td><span class="badge <%= u.perfil === 'ADMIN' ? 'badge-warning' : 'badge-default' %>"><%= u.perfil %></span></td>
                      <td style="text-align: center;">
                        <% if (u.ativo) { %>
                          <span class="badge badge-success">Ativo</span>
                        <% } else { %>
                          <span class="badge badge-default">Inativo</span>
                        <% } %>
                      </td>
                      <td class="col-actions">
                        <button class="btn btn-ghost btn-icon sm" title="Editar"
                          onclick="editar(this)"
                          data-id="<%= u.id %>"
                          data-nome="<%= u.nome %>"
                          data-username="<%= u.username %>"
                          data-perfil="<%= u.perfil %>"
                          data-ativo="<%= u.ativo %>">
                          <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-ghost btn-icon sm" title="Redefinir senha" onclick="abrirReset(<%= u.id %>, '<%= u.username %>')">
                          <i class="bi bi-key"></i>
                        </button>
                        <a href="/usuarios/delete/<%= u.id %>"
                           class="btn btn-danger btn-icon sm" title="Excluir"
                           onclick="return confirm('Tem certeza?');">
                          <i class="bi bi-trash3"></i>
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                  <% if (lista.length === 0) { %>
                    <tr>
                      <td colspan="4" class="empty-state">
                        <div class="empty-state-icon"><i class="bi bi-person-gear"></i></div>
                        <p>Nenhum usuario cadastrado.</p>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <div class="modal-backdrop" id="resetBackdrop" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
    <div class="card" style="max-width: 360px; width: 90%;">
      <div class="card-header">
        <h3>Redefinir senha</h3>
      </div>
      <div class="card-body">
        <form id="formReset" method="POST">
          <p style="margin-bottom: 12px;">Usuario: <strong id="resetUsername"></strong></p>
          <div class="form-group">
            <label class="form-label">Nova senha <span class="required">*</span></label>
            <input type="password" name="novaSenha" class="form-control" required minlength="4">
          </div>
          <div class="d-flex gap-sm" style="margin-top: 16px;">
            <button type="submit" class="btn btn-primary btn-block">Confirmar</button>
            <button type="button" class="btn btn-secondary btn-block" onclick="fecharReset()">Cancelar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/app.js"></script>

  <script>
    function editar(btn) {
      var d = btn.dataset;
      document.getElementById('inputNome').value = d.nome === 'null' ? '' : d.nome;
      document.getElementById('inputUsername').value = d.username;
      document.getElementById('selPerfil').value = d.perfil;
      document.getElementById('inputAtivo').checked = d.ativo === '1';

      var inputSenha = document.getElementById('inputSenha');
      inputSenha.required = false;
      inputSenha.value = '';
      inputSenha.disabled = true;
      document.getElementById('hintSenha').style.display = 'block';

      document.getElementById('formUsuario').action = "/usuarios/update/" + d.id;
      document.getElementById('formTitle').innerText = "Editar usuario";
      document.getElementById('btnSalvar').innerHTML = '<i class="bi bi-check-lg"></i> Atualizar';
      document.getElementById('btnCancelar').style.display = "block";
      document.querySelector('.form-panel').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function limparForm() {
      var form = document.getElementById('formUsuario');
      form.reset();
      form.classList.remove('was-validated');
      form.action = "/usuarios/add";
      document.getElementById('formTitle').innerText = "Novo usuario";
      document.getElementById('btnSalvar').innerHTML = '<i class="bi bi-check-lg"></i> Salvar';
      document.getElementById('btnCancelar').style.display = "none";

      var inputSenha = document.getElementById('inputSenha');
      inputSenha.required = true;
      inputSenha.disabled = false;
      document.getElementById('hintSenha').style.display = 'none';
    }

    function abrirReset(id, username) {
      document.getElementById('resetUsername').innerText = username;
      document.getElementById('formReset').action = "/usuarios/resetsenha/" + id;
      document.getElementById('resetBackdrop').style.display = 'flex';
    }

    function fecharReset() {
      document.getElementById('resetBackdrop').style.display = 'none';
    }
  </script>
</body>
</html>
