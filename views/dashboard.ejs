<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { pageTitle: 'Dashboard' }) %>
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">
      <%- include('partials/topbar', { topTitle: 'Dashboard', topSubtitle: 'Visao geral do sistema' }) %>

      <div class="page-content">
        <div class="kpi-grid" style="grid-template-columns: repeat(4, 1fr);">
          <div class="kpi-card stagger" style="--stagger-index: 0;">
            <div class="kpi-card-icon green"><i class="bi bi-currency-dollar"></i></div>
            <div class="kpi-card-value" data-countup="<%= stats.receita.toFixed(2) %>" data-money="true"><%= formatBRL(stats.receita) %></div>
            <div class="kpi-card-label">Receita total</div>
            <div class="kpi-card-trend up"><i class="bi bi-arrow-up-right"></i> Vendas</div>
          </div>

          <div class="kpi-card stagger" style="--stagger-index: 1;">
            <div class="kpi-card-icon red"><i class="bi bi-arrow-down-circle"></i></div>
            <div class="kpi-card-value" data-countup="<%= stats.despesa.toFixed(2) %>" data-money="true"><%= formatBRL(stats.despesa) %></div>
            <div class="kpi-card-label">Despesas totais</div>
            <div class="kpi-card-trend down"><i class="bi bi-arrow-down-right"></i> Compras</div>
          </div>

          <div class="kpi-card stagger" style="--stagger-index: 2;">
            <div class="kpi-card-icon blue"><i class="bi bi-box-seam"></i></div>
            <div class="kpi-card-value" data-countup="<%= stats.totalProdutos %>"><%= stats.totalProdutos %></div>
            <div class="kpi-card-label">Produtos cadastrados</div>
            <% if (stats.esgotados > 0) { %>
              <div class="kpi-card-trend down"><i class="bi bi-exclamation-circle"></i> <%= stats.esgotados %> esgotado(s)</div>
            <% } %>
          </div>

          <div class="kpi-card stagger" style="--stagger-index: 3;">
            <div class="kpi-card-icon amber"><i class="bi bi-people"></i></div>
            <div class="kpi-card-value" data-countup="<%= stats.totalClientes %>"><%= stats.totalClientes %></div>
            <div class="kpi-card-label">Clientes ativos</div>
          </div>
        </div>

        <% if (stats.lucro !== 0) { %>
        <div class="kpi-card stagger" style="--stagger-index: 4; display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-6);">
          <div class="d-flex items-center gap-sm">
            <div class="kpi-card-icon <%= stats.lucro >= 0 ? 'green' : 'red' %>" style="margin-bottom: 0;">
              <i class="bi bi-<%= stats.lucro >= 0 ? 'graph-up-arrow' : 'graph-down-arrow' %>"></i>
            </div>
            <div>
              <div class="kpi-card-label" style="margin-top: 0;">Resultado operacional</div>
              <div class="kpi-card-value" style="font-size: var(--text-xl); color: var(<%= stats.lucro >= 0 ? '--success' : '--error' %>);">
                <%= formatBRL(stats.lucro) %>
              </div>
            </div>
          </div>
          <span class="badge <%= stats.lucro >= 0 ? 'badge-success' : 'badge-error' %>">
            <%= stats.lucro >= 0 ? 'Superavitario' : 'Deficitario' %>
          </span>
        </div>
        <% } %>

        <h6 style="margin-bottom: var(--space-4);">Acesso rapido</h6>

        <div class="dashboard-grid" style="grid-template-columns: repeat(3, 1fr);">
          <a href="/compras" class="nav-card stagger" style="--stagger-index: 5;">
            <div class="nav-card-icon blue"><i class="bi bi-box-arrow-in-down"></i></div>
            <div class="nav-card-text">
              <h4>Compras</h4>
              <p>Lancar notas e estoque</p>
            </div>
          </a>

          <a href="/vendas" class="nav-card stagger" style="--stagger-index: 6;">
            <div class="nav-card-icon amber"><i class="bi bi-cart3"></i></div>
            <div class="nav-card-text">
              <h4>PDV Vendas</h4>
              <p>Registrar vendas</p>
            </div>
          </a>

          <a href="/relatorios" class="nav-card stagger" style="--stagger-index: 7;">
            <div class="nav-card-icon green"><i class="bi bi-bar-chart-line"></i></div>
            <div class="nav-card-text">
              <h4>Relatorios</h4>
              <p>Analise de performance</p>
            </div>
          </a>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); margin-top: var(--space-1);">
          <div class="table-wrapper stagger" style="--stagger-index: 8;">
            <div class="card-header">
              <h3><i class="bi bi-clock-history" style="color: var(--accent);"></i> Vendas recentes</h3>
              <a href="/relatorios" class="btn btn-ghost btn-sm">Ver todas</a>
            </div>
            <table class="data-table">
              <thead>
                <tr>
                  <th>Cliente</th>
                  <th>Pagamento</th>
                  <th style="text-align: right;">Valor</th>
                </tr>
              </thead>
              <tbody>
                <% vendasRecentes.forEach(v => { %>
                  <tr>
                    <td class="col-primary"><%= v.nomeCliente %></td>
                    <td><span class="badge badge-default"><%= v.formaPagamento %></span></td>
                    <td style="text-align: right;"><span class="text-primary fw-600"><%= formatBRL(v.valorTotal) %></span></td>
                  </tr>
                <% }) %>
                <% if (vendasRecentes.length === 0) { %>
                  <tr><td colspan="3" class="empty-state"><p>Nenhuma venda registrada.</p></td></tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <div class="table-wrapper stagger" style="--stagger-index: 9;">
            <div class="card-header">
              <h3><i class="bi bi-exclamation-triangle" style="color: var(--warning);"></i> Estoque baixo</h3>
              <a href="/produtos" class="btn btn-ghost btn-sm">Ver produtos</a>
            </div>
            <table class="data-table">
              <thead>
                <tr>
                  <th>Produto</th>
                  <th>Categoria</th>
                  <th style="text-align: right;">Qtd.</th>
                </tr>
              </thead>
              <tbody>
                <% estoqueBaixo.forEach(p => { %>
                  <tr>
                    <td class="col-primary"><%= p.nomeProduto %></td>
                    <td><span class="badge badge-default"><%= p.categoria %></span></td>
                    <td style="text-align: right;">
                      <span class="badge badge-warning"><%= p.estoqueAtual %> <%= p.unidadeMedida %></span>
                    </td>
                  </tr>
                <% }) %>
                <% if (estoqueBaixo.length === 0) { %>
                  <tr><td colspan="3" class="empty-state"><p>Estoque regular.</p></td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/app.js"></script>
</body>
</html>
