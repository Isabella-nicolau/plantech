<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { pageTitle: 'Fornecedores' }) %>
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">
      <%- include('partials/topbar', { topTitle: 'Fornecedores', topSubtitle: 'Parceiros de abastecimento e compras' }) %>

      <div class="page-content">
        <div class="page-header">
          <div class="page-header-left">
            <h2>Gestao de Fornecedores</h2>
          </div>
          <div class="page-header-actions">
            <button onclick="limparForm()" class="btn btn-primary btn-sm"><i class="bi bi-plus"></i> Novo fornecedor</button>
            <span class="badge-count"><%= lista.length %> registros</span>
          </div>
        </div>

        <% if (erro) { %>
          <div class="alert alert-error"><i class="bi bi-exclamation-circle"></i> <%= erro %></div>
        <% } %>

        <div class="split-layout">
          <div class="form-panel">
            <div class="form-panel-header">
              <i class="bi bi-truck"></i>
              <h3 id="formTitle">Novo fornecedor</h3>
            </div>
            <div class="form-panel-body">
              <form action="/fornecedores/add" method="POST" class="needs-validation" id="formForn" novalidate>
                <div class="form-group">
                  <label class="form-label">Razao social <span class="required">*</span></label>
                  <input type="text" name="nome" id="inputNome" class="form-control" required placeholder="Nome da empresa">
                  <div class="form-error">Nome e obrigatorio.</div>
                </div>

                <div class="form-group">
                  <label class="form-label">CNPJ <span class="required">*</span></label>
                  <div class="d-flex gap-sm">
                    <input type="text" name="cnpj" id="inputCnpj" class="form-control"
                           required placeholder="00.000.000/0000-00"
                           maxlength="18" oninput="mascaraCNPJ(this)" style="flex:1;">
                    <button type="button" class="btn btn-secondary btn-sm" onclick="buscarCNPJ()" id="btnBuscarCnpj" style="white-space:nowrap;">
                      <i class="bi bi-search"></i> Buscar
                    </button>
                  </div>
                  <div class="form-error">CNPJ e obrigatorio.</div>
                  <div id="cnpjFeedback" class="form-hint" style="display:none;"></div>
                </div>

                <div class="form-group">
                  <label class="form-label">Endereco <span class="required">*</span></label>
                  <textarea name="endereco" id="inputEnd" class="form-control" rows="2" required placeholder="Logradouro, Numero, Cidade - UF"></textarea>
                  <div class="form-error">Endereco e obrigatorio.</div>
                </div>

                <div class="row-2col">
                  <div class="form-group">
                    <label class="form-label">Telefone</label>
                    <input type="text" name="telefone" id="inputTel" class="form-control" placeholder="(00) 0000-0000" oninput="mascaraTelefone(this)" maxlength="15">
                  </div>
                  <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" id="inputEmail" class="form-control" placeholder="contato@forn.com">
                  </div>
                </div>

                <div class="d-flex gap-sm" style="margin-top: 20px;">
                  <button type="submit" class="btn btn-primary btn-block" id="btnSalvar">
                    <i class="bi bi-check-lg"></i> Salvar
                  </button>
                  <button type="button" class="btn btn-secondary btn-block" id="btnCancelar" onclick="limparForm()" style="display:none;">
                    Cancelar
                  </button>
                </div>
              </form>
            </div>
          </div>

          <div class="table-wrapper">
            <div class="card-header">
              <h3><i class="bi bi-list-ul" style="color: var(--primary);"></i> Base de fornecedores</h3>
            </div>
            <div class="table-scroll">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Empresa / CNPJ</th>
                    <th>Localizacao</th>
                    <th>Contato</th>
                    <th style="text-align: right;">Acao</th>
                  </tr>
                </thead>
                <tbody>
                  <% lista.forEach(f => { %>
                    <tr>
                      <td>
                        <div class="d-flex items-center gap-sm">
                          <div class="avatar blue">F</div>
                          <div>
                            <div class="col-primary"><%= f.nome %></div>
                            <div style="font-size: 0.75rem; color: var(--text-muted);"><%= f.cnpj %></div>
                          </div>
                        </div>
                      </td>
                      <td style="font-size: 0.8125rem; color: var(--text-muted); max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        <%= f.endereco %>
                      </td>
                      <td style="font-size: 0.8125rem; color: var(--text-secondary);">
                        <% if(f.email) { %><div><%= f.email %></div><% } %>
                        <% if(f.telefone) { %><div style="color: var(--text-muted);"><%= f.telefone %></div><% } %>
                      </td>
                      <td class="col-actions">
                        <button class="btn btn-ghost btn-icon sm" title="Editar"
                          onclick="editar(this)"
                          data-id="<%= f.idFornecedor %>"
                          data-nome="<%= f.nome %>"
                          data-cnpj="<%= f.cnpj %>"
                          data-tel="<%= f.telefone %>"
                          data-email="<%= f.email %>"
                          data-end="<%= f.endereco %>">
                          <i class="bi bi-pencil"></i>
                        </button>
                        <a href="/fornecedores/delete/<%= f.idFornecedor %>"
                           class="btn btn-danger btn-icon sm" title="Excluir"
                           onclick="return confirm('Excluir este fornecedor pode afetar o historico de compras. Continuar?');">
                          <i class="bi bi-trash3"></i>
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                  <% if(lista.length === 0) { %>
                    <tr>
                      <td colspan="4" class="empty-state">
                        <div class="empty-state-icon"><i class="bi bi-truck"></i></div>
                        <p>Nenhum fornecedor cadastrado.</p>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/app.js"></script>

  <script>
    function mascaraCNPJ(input) {
      var v = input.value.replace(/\D/g, "");
      if (v.length > 14) v = v.slice(0, 14);
      v = v.replace(/^(\d{2})(\d)/, "$1.$2");
      v = v.replace(/^(\d{2})\.(\d{3})(\d)/, "$1.$2.$3");
      v = v.replace(/\.(\d{3})(\d)/, ".$1/$2");
      v = v.replace(/(\d{4})(\d)/, "$1-$2");
      input.value = v;
    }

    function mascaraTelefone(input) {
      var v = input.value.replace(/\D/g, "");
      if (v.length > 11) v = v.slice(0, 11);
      v = v.replace(/^(\d{2})(\d)/g, "($1) $2");
      v = v.replace(/(\d)(\d{4})$/, "$1-$2");
      input.value = v;
    }

    function editar(btn) {
      var d = btn.dataset;
      document.getElementById('inputNome').value = d.nome;
      document.getElementById('inputCnpj').value = d.cnpj;
      document.getElementById('inputTel').value = d.tel;
      document.getElementById('inputEmail').value = d.email;
      document.getElementById('inputEnd').value = d.end;

      document.getElementById('formForn').action = "/fornecedores/update/" + d.id;
      document.getElementById('formTitle').innerText = "Editar fornecedor";
      document.getElementById('btnSalvar').innerHTML = '<i class="bi bi-check-lg"></i> Atualizar';
      document.getElementById('btnCancelar').style.display = "block";
      document.querySelector('.form-panel').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function limparForm() {
      var form = document.getElementById('formForn');
      form.reset();
      form.classList.remove('was-validated');
      form.action = "/fornecedores/add";
      document.getElementById('formTitle').innerText = "Novo fornecedor";
      document.getElementById('btnSalvar').innerHTML = '<i class="bi bi-check-lg"></i> Salvar';
      document.getElementById('btnCancelar').style.display = "none";
      document.getElementById('cnpjFeedback').style.display = "none";
    }

    async function buscarCNPJ() {
      var cnpj = document.getElementById('inputCnpj').value.replace(/\D/g, "");
      var feedback = document.getElementById('cnpjFeedback');
      var btn = document.getElementById('btnBuscarCnpj');

      if (cnpj.length !== 14) {
        feedback.textContent = "Digite um CNPJ completo (14 digitos).";
        feedback.style.display = "block";
        feedback.style.color = "var(--error)";
        return;
      }

      btn.disabled = true;
      btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Buscando...';
      feedback.textContent = "Consultando BrasilAPI...";
      feedback.style.display = "block";
      feedback.style.color = "var(--text-muted)";

      try {
        var response = await fetch("/fornecedores/consulta-cnpj/" + cnpj);
        var data = await response.json();

        if (data.erro) {
          feedback.textContent = data.erro;
          feedback.style.color = "var(--error)";
        } else {
          if (data.nome) document.getElementById('inputNome').value = data.nome;
          if (data.telefone) document.getElementById('inputTel').value = data.telefone;
          if (data.email) document.getElementById('inputEmail').value = data.email;
          if (data.endereco) document.getElementById('inputEnd').value = data.endereco;
          feedback.textContent = "Dados preenchidos automaticamente.";
          feedback.style.color = "var(--success)";
        }
      } catch (err) {
        feedback.textContent = "Erro de conexao ao buscar CNPJ.";
        feedback.style.color = "var(--error)";
      }

      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-search"></i> Buscar';
    }
  </script>
</body>
</html>
