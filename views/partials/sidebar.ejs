<button class="sidebar-toggle" onclick="toggleSidebar()" aria-label="Abrir menu">
  <i class="bi bi-list"></i>
</button>
<div class="sidebar-overlay" onclick="toggleSidebar()"></div>

<% var perfil = (typeof sessionUser !== 'undefined' && sessionUser) ? sessionUser.perfil : 'OPERADOR'; %>
<% var userName = (typeof sessionUser !== 'undefined' && sessionUser) ? sessionUser.username : ''; %>

<aside class="sidebar" role="navigation" aria-label="Menu principal">
  <div class="sidebar-header">
    <a href="/dashboard" class="sidebar-logo">
      <div class="sidebar-logo-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 20h10"/>
          <path d="M10 20c5.5-2.5.8-6.4 3-10"/>
          <path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z"/>
          <path d="M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z"/>
        </svg>
      </div>
      <span class="sidebar-logo-text">Plantech<span class="sidebar-logo-badge">ERP</span></span>
    </a>
  </div>

  <nav class="sidebar-nav">
    <div class="sidebar-section-label">Menu</div>

    <a href="/dashboard" class="sidebar-nav-link" data-page="dashboard">
      <i class="bi bi-grid-1x2"></i>
      <span>Dashboard</span>
    </a>

    <div class="sidebar-section-label">Movimentos</div>

    <% if (perfil === 'ADMIN') { %>
    <a href="/compras" class="sidebar-nav-link" data-page="compras">
      <i class="bi bi-box-arrow-in-down"></i>
      <span>Compras</span>
    </a>
    <% } %>

    <a href="/vendas" class="sidebar-nav-link" data-page="vendas">
      <i class="bi bi-cart3"></i>
      <span>Vendas</span>
    </a>

    <a href="/ordens" class="sidebar-nav-link" data-page="ordens">
      <i class="bi bi-clipboard-check"></i>
      <span>Ordens de Servico</span>
    </a>

    <div class="sidebar-section-label">Cadastros</div>

    <% if (perfil === 'ADMIN') { %>
    <a href="/produtos" class="sidebar-nav-link" data-page="produtos">
      <i class="bi bi-box-seam"></i>
      <span>Produtos</span>
    </a>
    <% } %>

    <a href="/clientes" class="sidebar-nav-link" data-page="clientes">
      <i class="bi bi-people"></i>
      <span>Clientes</span>
    </a>

    <% if (perfil === 'ADMIN') { %>
    <a href="/fornecedores" class="sidebar-nav-link" data-page="fornecedores">
      <i class="bi bi-truck"></i>
      <span>Fornecedores</span>
    </a>
    <% } %>

    <a href="/categorias" class="sidebar-nav-link" data-page="categorias">
      <i class="bi bi-tags"></i>
      <span>Categorias</span>
    </a>

    <a href="/servicos" class="sidebar-nav-link" data-page="servicos">
      <i class="bi bi-tools"></i>
      <span>Servicos</span>
    </a>

    <% if (perfil === 'ADMIN') { %>
    <a href="/funcionarios" class="sidebar-nav-link" data-page="funcionarios">
      <i class="bi bi-person-badge"></i>
      <span>Funcionarios</span>
    </a>
    <% } %>

    <div class="sidebar-section-label">Analise</div>

    <a href="<%= perfil === 'ADMIN' ? '/relatorios' : '/relatorios/compras' %>" class="sidebar-nav-link" data-page="relatorios">
      <i class="bi bi-bar-chart-line"></i>
      <span>Relatorios</span>
    </a>

    <% if (perfil === 'ADMIN') { %>
    <a href="/auditoria" class="sidebar-nav-link" data-page="auditoria">
      <i class="bi bi-shield-check"></i>
      <span>Auditoria</span>
    </a>

    <div class="sidebar-section-label">Admin</div>

    <a href="/usuarios" class="sidebar-nav-link" data-page="usuarios">
      <i class="bi bi-person-gear"></i>
      <span>Usuarios</span>
    </a>
    <% } %>
  </nav>

  <div class="sidebar-footer">
    <% if (userName) { %>
    <div class="sidebar-user-info">
      <div class="sidebar-user-avatar"><%= userName.charAt(0).toUpperCase() %></div>
      <div class="sidebar-user-meta">
        <span class="sidebar-user-name"><%= userName %></span>
        <span class="sidebar-user-role"><%= perfil %></span>
      </div>
    </div>
    <% } %>
    <a href="#" class="sidebar-nav-link" onclick="toggleTheme(); return false;">
      <i class="bi bi-moon" id="themeIcon"></i>
      <span id="themeLabel">Modo claro</span>
    </a>
    <a href="/login/logout" class="sidebar-nav-link">
      <i class="bi bi-box-arrow-right"></i>
      <span>Sair</span>
    </a>
  </div>
</aside>
