<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { pageTitle: 'Acesso Negado' }) %>
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">
      <%- include('partials/topbar', { topTitle: 'Acesso Negado', topSubtitle: '' }) %>

      <div class="page-content">
        <div style="text-align: center; padding: var(--space-9) var(--space-5);">
          <div style="width: 64px; height: 64px; border-radius: var(--radius-lg); background: var(--error-subtle); color: var(--error); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin: 0 auto var(--space-6);">
            <i class="bi bi-shield-lock"></i>
          </div>
          <h2 style="margin-bottom: var(--space-2);">Acesso restrito</h2>
          <p style="color: var(--text-muted); margin-bottom: var(--space-6); max-width: 360px; margin-left: auto; margin-right: auto; line-height: var(--leading-loose);">
            Seu perfil <span class="badge badge-default"><%= user.perfil %></span> nao tem permissao para esta area.
          </p>
          <a href="/dashboard" class="btn btn-primary">
            <i class="bi bi-arrow-left"></i> Voltar ao Dashboard
          </a>
        </div>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/app.js"></script>
</body>
</html>
