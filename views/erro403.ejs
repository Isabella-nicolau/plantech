<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { pageTitle: 'Acesso Negado' }) %>
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">
