<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { pageTitle: 'Relatorio de Clientes' }) %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">
      <%- include('partials/topbar', { topTitle: 'Relatorios', topSubtitle: 'Ranking de clientes por faturamento' }) %>

      <div class="page-content">
        <div class="page-header">
          <div class="page-header-left">
            <h2>Clientes por Faturamento</h2>
          </div>
          <% var podeAdmin = (typeof sessionUser !== 'undefined' && sessionUser && sessionUser.perfil === 'ADMIN'); %>
          <div class="quick-nav">
            <% if (podeAdmin) { %>
              <a href="/relatorios">Vendas</a>
              <a href="/relatorios/saidas">Saidas</a>
              <a href="/relatorios/estoque">Estoque</a>
              <a href="/relatorios/financeiro">Financeiro</a>
            <% } %>
            <a href="/relatorios/compras">Compras</a>
            <a href="/relatorios/servicos">Servicos</a>
            <a href="/relatorios/clientes" class="active">Clientes</a>
          </div>
        </div>

        <div class="card" style="margin-bottom: 24px;">
          <div class="card-body">
            <form action="/relatorios/clientes" method="GET" class="d-flex gap-sm items-center" style="flex-wrap: wrap;">
              <div style="flex: 1; min-width: 160px;">
                <label class="form-label">Data inicio</label>
                <input type="date" name="dataInicio" class="form-control" value="<%= query.dataInicio %>">
              </div>
              <div style="flex: 1; min-width: 160px;">
                <label class="form-label">Data fim</label>
                <input type="date" name="dataFim" class="form-control" value="<%= query.dataFim %>">
              </div>
              <div style="padding-top: 22px;">
                <button class="btn btn-primary">Filtrar</button>
              </div>
            </form>
          </div>
        </div>

        <% if (erro) { %>
          <div class="alert alert-error"><i class="bi bi-exclamation-circle"></i> <%= erro %></div>
        <% } %>

        <div class="table-wrapper">
          <div class="card-header">
            <h3><i class="bi bi-trophy" style="color: var(--warning);"></i> Ranking de clientes</h3>
            <button onclick="baixarPDFClientes()" class="btn btn-secondary btn-sm no-print">
              <i class="bi bi-download"></i> Baixar PDF
            </button>
          </div>
          <table class="data-table">
            <thead>
              <tr>
                <th>Cliente</th>
                <th style="text-align: right;">Vendas (PDV)</th>
                <th style="text-align: right;">Servicos concluidos</th>
                <th style="text-align: right;">Faturamento total</th>
              </tr>
            </thead>
            <tbody>
              <% lista.forEach((c, index) => { %>
                <tr>
                  <td>
                    <div class="d-flex items-center gap-sm">
                      <% if (index < 3 && c.totalFaturamento > 0) { %>
                        <span class="badge badge-warning"><%= index + 1 %>o</span>
                      <% } %>
                      <span class="col-primary"><%= c.nome %></span>
                    </div>
                  </td>
                  <td style="text-align: right;"><%= formatBRL(c.totalVendas) %></td>
                  <td style="text-align: right;"><%= formatBRL(c.totalOS) %></td>
                  <td style="text-align: right;"><span class="badge badge-success"><%= formatBRL(c.totalFaturamento) %></span></td>
                </tr>
              <% }) %>
              <% if (lista.length === 0) { %>
                <tr><td colspan="4" class="empty-state"><p>Nenhum cliente cadastrado.</p></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="text-center mt-24" style="font-size: 0.75rem; color: var(--text-muted);">
          Relatorio gerado em <%= new Date().toLocaleDateString() %> as <%= new Date().toLocaleTimeString() %>
        </div>
      </div>
    </main>
  </div>

  <div id="relatorio-pdf" class="report-pdf">
    <div class="report-header">
      <div>
        <h1>Plantech ERP</h1>
        <h2>Relatorio de Clientes por Faturamento</h2>
      </div>
      <div class="report-info">
        <p><strong>Carrapicho Jardinagem</strong></p>
        <p>CNPJ: 32.665.550/0001-00</p>
        <p>Periodo: <%= query.dataInicio || 'Inicio' %> a <%= query.dataFim || 'Hoje' %></p>
        <p>Emissao: <%= new Date().toLocaleString() %></p>
      </div>
    </div>
    <br>
    <table class="report-table">
      <thead>
        <tr>
          <th style="width: 40%;">Cliente</th>
          <th style="width: 20%; text-align: right;">Vendas</th>
          <th style="width: 20%; text-align: right;">Servicos</th>
          <th style="width: 20%; text-align: right;">Total</th>
        </tr>
      </thead>
      <tbody>
        <% if (lista && lista.length > 0) { %>
          <% lista.forEach(c => { %>
            <tr>
              <td><strong><%= c.nome %></strong></td>
              <td style="text-align: right;"><%= formatBRL(c.totalVendas) %></td>
              <td style="text-align: right;"><%= formatBRL(c.totalOS) %></td>
              <td style="text-align: right; font-weight: bold;"><%= formatBRL(c.totalFaturamento) %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="4" style="text-align:center; padding: 20px; color:#777;">Nenhum cliente cadastrado.</td></tr>
        <% } %>
      </tbody>
    </table>
    <div class="report-footer">
      <span>Sistema Plantech v2.5</span>
      <span>Ranking gerencial de clientes.</span>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/app.js"></script>

  <script>
    function baixarPDFClientes() {
      var elemento = document.getElementById('relatorio-pdf');
      elemento.style.display = 'block';
      var opt = {
        margin: [10, 10, 15, 10],
        filename: 'Relatorio_Clientes_Plantech.pdf',
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, scrollY: 0 },
        pagebreak: { mode: ['avoid-all', 'css', 'legacy'] },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
      };
      html2pdf().set(opt).from(elemento).save().then(function() { elemento.style.display = 'none'; });
    }
  </script>
</body>
</html>
