<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { pageTitle: 'Vendas' }) %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">
      <%- include('partials/topbar', { topTitle: 'Ponto de Venda', topSubtitle: 'Registre saidas e emita comprovantes' }) %>

      <div class="page-content">
        <div class="page-header">
          <div class="page-header-left">
            <h2>PDV</h2>
          </div>
          <div class="page-header-actions">
            <span class="badge-count"><%= new Date().toLocaleDateString() %></span>
          </div>
        </div>

        <% if (erro) { %>
          <div class="alert alert-error"><i class="bi bi-exclamation-circle"></i> <%= erro %></div>
        <% } %>
        <% if (locals.sucesso) { %>
          <div class="alert alert-success"><i class="bi bi-check-circle"></i> <%= sucesso %></div>
        <% } %>

        <div class="split-layout">
          <div class="form-panel">
            <div class="form-panel-header">
              <i class="bi bi-cart3"></i>
              <h3>Nova venda</h3>
            </div>
            <div class="form-panel-body">
              <form action="/vendas/add" method="POST" id="formVenda">
                <div class="form-group">
                  <label class="form-label">Cliente</label>
                  <select name="idCliente" class="form-select" required>
                    <option value="" disabled selected>Selecione...</option>
                    <% clientes.forEach(c => { %>
                      <option value="<%= c.idCliente %>"><%= c.nome %></option>
                    <% }) %>
                  </select>
                </div>

                <div class="form-group">
                  <label class="form-label">Pagamento</label>
                  <select name="formaPagamento" class="form-select" required>
                    <option value="Dinheiro">Dinheiro</option>
                    <option value="Pix">Pix</option>
                    <option value="Cartão Crédito">Cartao de Credito</option>
                    <option value="Cartão Débito">Cartao de Debito</option>
                  </select>
                </div>

                <div class="divider"></div>

                <h6 style="margin-bottom: 12px;">Adicionar produtos</h6>

                <div class="form-group">
                  <select id="selProduto" class="form-select">
                    <option value="" disabled selected>Pesquisar item...</option>
                    <% produtos.forEach(p => { %>
                      <option value="<%= p.numProduto %>" data-preco="<%= p.precoVenda %>" data-nome="<%= p.nomeProduto %>" data-estoque="<%= p.estoqueAtual %>">
                        <%= p.nomeProduto %> (<%= formatBRL(p.precoVenda) %> — Est: <%= p.estoqueAtual %>)
                      </option>
                    <% }) %>
                  </select>
                </div>

                <div class="d-flex gap-sm" style="margin-bottom: 16px;">
                  <input type="number" id="qtdProduto" class="form-control" value="1" min="1" style="width: 80px; text-align: center;">
                  <button type="button" class="btn btn-secondary flex-1" onclick="adicionarAoCarrinho()">
                    <i class="bi bi-plus"></i> Adicionar
                  </button>
                </div>

                <input type="hidden" name="itensCarrinho" id="inputItensCarrinho">

                <div class="divider"></div>

                <button class="btn btn-primary btn-block btn-lg">
                  <i class="bi bi-check-lg"></i> Finalizar venda
                </button>
              </form>
            </div>
          </div>

          <div>
            <div class="table-wrapper" style="margin-bottom: 20px;">
              <div class="card-header">
                <h3><i class="bi bi-bag" style="color: var(--warning);"></i> Carrinho</h3>
              </div>
              <div class="cart-container">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Produto</th>
                      <th style="text-align: center;">Qtd</th>
                      <th style="text-align: right;">Unit.</th>
                      <th style="text-align: right;">Total</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody id="listaCarrinho">
                    <tr><td colspan="5" class="empty-state"><p>Carrinho vazio.</p></td></tr>
                  </tbody>
                </table>
              </div>
              <div style="padding: 16px 20px; border-top: 1px solid var(--border-color);">
                <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 12px; flex-wrap: wrap;">
                  <label class="form-label" style="margin: 0; white-space: nowrap; font-size: 0.8125rem;">Desconto</label>
                  <input type="number" id="inputDesconto" form="formVenda" name="desconto" class="form-control" placeholder="0.00" step="0.01" min="0" oninput="recalcularTotal()" style="max-width: 100px;">
                  <div class="btn-group btn-group-sm" role="group" aria-label="Tipo de desconto">
                    <button type="button" class="btn btn-primary" id="btnDescontoValor" onclick="setTipoDesconto('V')">R$</button>
                    <button type="button" class="btn btn-ghost" id="btnDescontoPercentual" onclick="setTipoDesconto('P')">%</button>
                  </div>
                  <input type="hidden" id="inputTipoDesconto" form="formVenda" name="tipoDesconto" value="V">
                </div>
                <div class="summary-total">
                  <div>
                    <span class="label">Total a pagar</span>
                    <div style="font-size: 0.75rem; color: var(--text-muted);" id="subtotalDisplay">Subtotal: <%= formatBRL(0) %></div>
                  </div>
                  <span class="value" id="totalVendaDisplay"><%= formatBRL(0) %></span>
                </div>
              </div>
            </div>

            <div class="table-wrapper">
              <div class="card-header">
                <h3><i class="bi bi-clock-history" style="color: var(--text-muted);"></i> Vendas recentes</h3>
              </div>
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Data</th>
                    <th>Cliente</th>
                    <th>Pgto</th>
                    <th style="text-align: right;">Valor</th>
                    <th style="text-align: right;">Acao</th>
                  </tr>
                </thead>
                <tbody>
                  <% historico.slice(0, 5).forEach(v => { %>
                    <tr>
                      <td style="color: var(--text-muted);"><%= new Date(v.dataVenda).toLocaleDateString() %></td>
                      <td class="col-primary"><%= v.nomeCliente %></td>
                      <td><span class="badge badge-default"><%= v.formaPagamento %></span></td>
                      <td style="text-align: right;"><span class="text-primary fw-600"><%= formatBRL(v.valorTotal) %></span></td>
                      <td class="col-actions">
                        <button onclick="imprimirComprovante(<%= v.idVenda %>)" class="btn btn-ghost btn-sm">
                          <i class="bi bi-printer"></i> Cupom
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                  <% if(historico.length === 0) { %>
                    <tr><td colspan="5" class="empty-state"><p>Nenhuma venda registrada.</p></td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <div id="area-comprovante" class="receipt">
    <div class="receipt-header">
      <h3 style="margin:0; font-size:16px;">Carrapicho Jardinagem</h3>
      <p style="margin:5px 0;">Rondon - PR | (44) 99927-0171</p>
      <p style="font-size:10px;">CNPJ: 32.665.550/0001-00</p>
      <hr style="border-top:1px dashed #000;">
      <h4 style="margin:5px 0; font-size:14px;">COMPROVANTE DE VENDA</h4>
      <p style="margin:0;" id="cupom-id">#000</p>
      <p style="margin:0;" id="cupom-data">00/00/0000</p>
    </div>
    <div style="margin-bottom:10px; font-size:12px;">
      <strong>Cliente:</strong> <span id="cupom-cliente">Nome</span><br>
      <strong>Pagamento:</strong> <span id="cupom-pgto">Dinheiro</span>
    </div>
    <table class="receipt-table">
      <thead><tr><th style="width:10%">Qtd</th><th>Item</th><th style="text-align:right;">R$</th></tr></thead>
      <tbody id="cupom-itens"></tbody>
    </table>
    <div class="receipt-total">
      <p style="margin:2px 0;">Subtotal: <span id="cupom-subtotal"><%= formatBRL(0) %></span></p>
      <p style="margin:2px 0;">Desconto: - <span id="cupom-desconto"><%= formatBRL(0) %></span></p>
      <h3 style="margin:5px 0; font-size:16px;">TOTAL: <span id="cupom-total"><%= formatBRL(0) %></span></h3>
    </div>
    <div style="text-align:center; margin-top:20px; font-size:10px;">
      <p>Obrigado pela preferencia!</p>
      <p>Sistema Plantech</p>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/app.js"></script>

  <script>
    var carrinho = [];

    function mostrarAlerta(msg, tipo) {
      var container = document.getElementById('alertaVenda');
      if (!container) {
        container = document.createElement('div');
        container.id = 'alertaVenda';
        document.querySelector('.page-content').prepend(container);
      }
      var cls = tipo === 'error' ? 'alert-error' : 'alert-success';
      var icon = tipo === 'error' ? 'bi-exclamation-circle' : 'bi-check-circle';
      container.innerHTML = '<div class="alert ' + cls + '"><i class="bi ' + icon + '"></i> ' + msg + '</div>';
      setTimeout(function() { container.innerHTML = ''; }, 5000);
    }

    function estoqueDisponivelParaProduto(idProduto) {
      var opt = document.querySelector('#selProduto option[value="' + idProduto + '"]');
      var estoqueOriginal = opt ? parseInt(opt.getAttribute('data-estoque')) : 0;
      var jaNoCarrinho = carrinho.filter(function(i) { return i.id === idProduto; })
        .reduce(function(acc, i) { return acc + i.qtd; }, 0);
      return estoqueOriginal - jaNoCarrinho;
    }

    function adicionarAoCarrinho() {
      var sel = document.getElementById('selProduto');
      var qtdInput = document.getElementById('qtdProduto');
      var id = sel.value;
      var opt = sel.options[sel.selectedIndex];
      var nome = opt ? opt.getAttribute('data-nome') : '';
      var preco = parseFloat(opt ? opt.getAttribute('data-preco') : 0);
      var qtd = parseInt(qtdInput.value);

      if (!id) { mostrarAlerta("Selecione um produto.", "error"); return; }
      if (qtd <= 0 || isNaN(qtd)) { mostrarAlerta("Quantidade invalida.", "error"); return; }

      var disponivel = estoqueDisponivelParaProduto(id);
      if (qtd > disponivel) {
        mostrarAlerta('Estoque insuficiente para "' + nome + '". Disponivel: ' + disponivel + ' unidade(s).', "error");
        return;
      }

      carrinho.push({ id: id, nome: nome, qtd: qtd, preco: preco });
      renderCarrinho();
      sel.value = ""; qtdInput.value = "1"; sel.focus();
    }

    function removerItem(index) {
      carrinho.splice(index, 1);
      renderCarrinho();
    }

    function renderCarrinho() {
      var tbody = document.getElementById('listaCarrinho');
      tbody.innerHTML = "";
      if (carrinho.length === 0) tbody.innerHTML = '<tr><td colspan="5" class="empty-state"><p>Carrinho vazio.</p></td></tr>';

      carrinho.forEach(function(item, index) {
        var subtotal = item.qtd * item.preco;
        var tr = document.createElement('tr');
        tr.innerHTML = '<td class="col-primary">' + item.nome + '</td>' +
          '<td style="text-align:center;">' + item.qtd + '</td>' +
          '<td style="text-align:right;">' + formatBRL(item.preco) + '</td>' +
          '<td style="text-align:right;" class="fw-600">' + formatBRL(subtotal) + '</td>' +
          '<td class="col-actions"><button type="button" class="btn btn-danger btn-icon sm" onclick="removerItem(' + index + ')"><i class="bi bi-x-lg"></i></button></td>';
        tbody.appendChild(tr);
      });
      recalcularTotal();
      document.getElementById('inputItensCarrinho').value = JSON.stringify(carrinho);
    }

    function setTipoDesconto(tipo) {
      document.getElementById('inputTipoDesconto').value = tipo;
      var btnValor = document.getElementById('btnDescontoValor');
      var btnPercentual = document.getElementById('btnDescontoPercentual');
      btnValor.classList.toggle('btn-primary', tipo === 'V');
      btnValor.classList.toggle('btn-ghost', tipo !== 'V');
      btnPercentual.classList.toggle('btn-primary', tipo === 'P');
      btnPercentual.classList.toggle('btn-ghost', tipo !== 'P');
      recalcularTotal();
    }

    function recalcularTotal() {
      var subtotal = carrinho.reduce(function(acc, item) { return acc + (item.qtd * item.preco); }, 0);
      var desconto = parseFloat(document.getElementById('inputDesconto').value) || 0;
      var tipo = document.getElementById('inputTipoDesconto').value;
      var descontoAbsoluto = tipo === 'P' ? (subtotal * desconto / 100) : desconto;
      var totalFinal = Math.max(0, subtotal - descontoAbsoluto);
      document.getElementById('subtotalDisplay').innerText = "Subtotal: " + formatBRL(subtotal);
      document.getElementById('totalVendaDisplay').innerText = formatBRL(totalFinal);
    }

    document.getElementById('formVenda').onsubmit = function(e) {
      document.getElementById('inputItensCarrinho').value = JSON.stringify(carrinho);
      if (carrinho.length === 0) { alert("Adicione pelo menos um produto!"); e.preventDefault(); return false; }
      return true;
    };

    async function imprimirComprovante(idVenda) {
      try {
        var response = await fetch('/vendas/comprovante/' + idVenda);
        var data = await response.json();
        if (data.error) return alert("Erro: " + data.error);

        var venda = data.venda;
        var itens = data.itens;

        document.getElementById('cupom-id').innerText = "#" + venda.idVenda;
        document.getElementById('cupom-data').innerText = new Date(venda.dataVenda).toLocaleString();
        document.getElementById('cupom-cliente').innerText = venda.nomeCliente;
        document.getElementById('cupom-pgto').innerText = venda.formaPagamento;
        document.getElementById('cupom-subtotal').innerText = formatBRL(venda.subtotal || venda.valorTotal);
        document.getElementById('cupom-desconto').innerText = venda.tipoDesconto === 'P'
          ? (venda.desconto || 0) + '%'
          : formatBRL(venda.desconto || 0);
        document.getElementById('cupom-total').innerText = formatBRL(venda.valorTotal);

        var tbody = document.getElementById('cupom-itens');
        tbody.innerHTML = "";
        itens.forEach(function(item) {
          tbody.innerHTML += '<tr><td>' + item.quantidade + 'x</td><td>' + item.nomeProduto + '</td><td style="text-align:right;">' + formatBRL(item.quantidade * item.precoUnitario) + '</td></tr>';
        });

        var elemento = document.getElementById('area-comprovante');
        elemento.style.display = 'block';

        var opt = {
          margin: 0,
          filename: 'Cupom_Venda_' + venda.idVenda + '.pdf',
          image: { type: 'jpeg', quality: 0.98 },
          html2canvas: { scale: 2, scrollY: 0 },
          jsPDF: { unit: 'mm', format: [80, 2000], orientation: 'portrait' }
        };

        await html2pdf().set(opt).from(elemento).save();
        elemento.style.display = 'none';
      } catch (err) {
        console.error(err);
        alert("Erro ao imprimir.");
      }
    }
  </script>
</body>
</html>
