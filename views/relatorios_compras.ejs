<!DOCTYPE html>
<html lang="pt-br">
<head>
  <%- include('partials/head', { pageTitle: 'Relatorio de Compras' }) %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">
      <%- include('partials/topbar', { topTitle: 'Relatorios', topSubtitle: 'Compras por periodo' }) %>

      <div class="page-content">
        <div class="page-header">
          <div class="page-header-left">
            <h2>Compras por Periodo</h2>
          </div>
          <% var podeAdmin = (typeof sessionUser !== 'undefined' && sessionUser && sessionUser.perfil === 'ADMIN'); %>
          <div class="quick-nav">
            <% if (podeAdmin) { %>
              <a href="/relatorios">Vendas</a>
              <a href="/relatorios/saidas">Saidas</a>
              <a href="/relatorios/estoque">Estoque</a>
              <a href="/relatorios/financeiro">Financeiro</a>
            <% } %>
            <a href="/relatorios/compras" class="active">Compras</a>
            <a href="/relatorios/servicos">Servicos</a>
            <a href="/relatorios/clientes">Clientes</a>
          </div>
        </div>

        <div class="card" style="margin-bottom: 24px;">
          <div class="card-body">
            <form action="/relatorios/compras" method="GET" class="d-flex gap-sm items-center" style="flex-wrap: wrap;">
              <div style="flex: 1; min-width: 160px;">
                <label class="form-label">Data inicio</label>
                <input type="date" name="dataInicio" class="form-control" value="<%= query.dataInicio %>">
              </div>
              <div style="flex: 1; min-width: 160px;">
                <label class="form-label">Data fim</label>
                <input type="date" name="dataFim" class="form-control" value="<%= query.dataFim %>">
              </div>
              <div style="padding-top: 22px;">
                <button class="btn btn-primary">Filtrar</button>
              </div>
            </form>
          </div>
        </div>

        <% if (erro) { %>
          <div class="alert alert-error"><i class="bi bi-exclamation-circle"></i> <%= erro %></div>
        <% } %>

        <div class="kpi-grid" style="grid-template-columns: 1fr; margin-bottom: 24px;">
          <div class="kpi-card" style="text-align: center; padding: 32px;">
            <div class="kpi-card-label" style="margin-bottom: 8px;">Total de despesas no periodo</div>
            <div class="kpi-card-value" style="font-size: 2rem;"><%= formatBRL(totalDespesas) %></div>
            <div style="margin-top: 8px;"><span class="badge badge-info"><%= lista.length %> compras registradas</span></div>
          </div>
        </div>

        <div class="table-wrapper">
          <div class="card-header">
            <h3><i class="bi bi-list-ul" style="color: var(--primary);"></i> Compras no periodo</h3>
            <button onclick="baixarPDFCompras()" class="btn btn-secondary btn-sm no-print">
              <i class="bi bi-download"></i> Baixar PDF
            </button>
          </div>
          <table class="data-table">
            <thead>
              <tr>
                <th>Data</th>
                <th>Fornecedor</th>
                <th style="text-align: right;">Valor total</th>
              </tr>
            </thead>
            <tbody>
              <% lista.forEach(item => { %>
                <tr>
                  <td style="color: var(--text-muted);"><%= new Date(item.dataCompra).toLocaleDateString() %></td>
                  <td class="col-primary"><%= item.fornecedor %></td>
                  <td style="text-align: right;"><span class="badge badge-info"><%= formatBRL(item.valorTotal) %></span></td>
                </tr>
              <% }) %>
              <% if (lista.length === 0) { %>
                <tr><td colspan="3" class="empty-state"><p>Nenhuma compra no periodo.</p></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="text-center mt-24" style="font-size: 0.75rem; color: var(--text-muted);">
          Relatorio gerado em <%= new Date().toLocaleDateString() %> as <%= new Date().toLocaleTimeString() %>
        </div>
      </div>
    </main>
  </div>

  <div id="relatorio-pdf" class="report-pdf">
    <div class="report-header">
      <div>
        <h1>Plantech ERP</h1>
        <h2>Relatorio de Compras por Periodo</h2>
      </div>
      <div class="report-info">
        <p><strong>Carrapicho Jardinagem</strong></p>
        <p>CNPJ: 32.665.550/0001-00</p>
        <p>Periodo: <%= query.dataInicio || 'Inicio' %> a <%= query.dataFim || 'Hoje' %></p>
        <p>Emissao: <%= new Date().toLocaleString() %></p>
      </div>
    </div>
    <div class="report-summary" style="display: flex; justify-content: space-between; align-items: center;">
      <div><span>Total de Compras:</span> <strong><%= lista.length %></strong></div>
      <div style="font-weight: bold; font-size: 14px; color: #c62828;"><span>Despesas:</span> <%= formatBRL(totalDespesas) %></div>
    </div>
    <br>
    <table class="report-table">
      <thead>
        <tr>
          <th style="width: 20%;">Data</th>
          <th style="width: 50%;">Fornecedor</th>
          <th style="width: 30%; text-align: right;">Valor</th>
        </tr>
      </thead>
      <tbody>
        <% if (lista && lista.length > 0) { %>
          <% lista.forEach(item => { %>
            <tr>
              <td><%= new Date(item.dataCompra).toLocaleDateString() %></td>
              <td><strong><%= item.fornecedor %></strong></td>
              <td style="text-align: right; font-weight: bold;"><%= formatBRL(item.valorTotal) %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="3" style="text-align:center; padding: 20px; color:#777;">Nenhuma compra registrada neste periodo.</td></tr>
        <% } %>
      </tbody>
    </table>
    <div class="report-footer">
      <span>Sistema Plantech v2.5</span>
      <span>Relatorio gerencial de compras.</span>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/app.js"></script>

  <script>
    function baixarPDFCompras() {
      var elemento = document.getElementById('relatorio-pdf');
      elemento.style.display = 'block';
      var opt = {
        margin: [10, 10, 15, 10],
        filename: 'Relatorio_Compras_Plantech.pdf',
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, scrollY: 0 },
        pagebreak: { mode: ['avoid-all', 'css', 'legacy'] },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
      };
      html2pdf().set(opt).from(elemento).save().then(function() { elemento.style.display = 'none'; });
    }
  </script>
</body>
</html>
